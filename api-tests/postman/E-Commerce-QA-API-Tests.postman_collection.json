  "item": [
    {
      "name": "01 - Get All Posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code 200 olmalı\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response JSON olmalı\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Post listesi boş olmamalı\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"İlk post gerekli alanlara sahip olmalı\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData[0]).to.have.property(\"userId\");\r",
              "    pm.expect(jsonData[0]).to.have.property(\"id\");\r",
              "    pm.expect(jsonData[0]).to.have.property(\"title\");\r",
              "    pm.expect(jsonData[0]).to.have.property(\"body\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response 2 saniyeden kısa olmalı\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
